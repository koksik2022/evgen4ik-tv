#!/bin/bash
# Evgen4ik TV — управление на сервере. Справка: e4tv help
set -u
CONF=${E4TV_CONF:-/etc/evgen4ik-tv/config.json}
APP=/opt/evgen4ik-tv
UNITS="e4tv-editor.service e4tv-build.path e4tv-build.timer e4tv-lists.path e4tv-lists.timer e4tv-activity.timer e4tv-update.path e4tv-check.path e4tv-check.timer"

c() { python3 -c 'import json,sys; c=json.load(open(sys.argv[1])); v=c
for k in sys.argv[2].split("."): v=v.get(k,"") if isinstance(v,dict) else ""
print(v)' "$CONF" "$1" 2>/dev/null; }
need_root() { [ "$(id -u)" = 0 ] || { echo "Нужны права root: sudo e4tv $*"; exit 1; }; }

set_auth() {   # set_auth <логин> <пароль>  (пароль можно передать и через E4PW)
  local file; file=$(c auth_file); file=${file:-/etc/evgen4ik-tv/auth.json}
  E4PW="${2:-${E4PW:-}}" python3 - "$1" "$file" <<'P'
import hashlib, json, os, secrets, sys
user, path = sys.argv[1], sys.argv[2]
pw = os.environ.get("E4PW", "")
if len(pw) < 6: sys.exit("Пароль должен быть не короче 6 символов")
salt, it = secrets.token_bytes(16), 200000
h = hashlib.pbkdf2_hmac("sha256", pw.encode(), salt, it).hex()
tmp = path + ".tmp"
with open(tmp, "w") as f: json.dump({"user": user, "pbkdf2": f"{it}${salt.hex()}${h}", "secret": secrets.token_hex(32)}, f)
os.chmod(tmp, 0o640)
try:
    import grp; os.chown(tmp, 0, grp.getgrnam("e4tv").gr_gid)
except Exception: pass
os.replace(tmp, path)
P
}

info() {
  echo "Режим:              $( [ "$(c mode)" = hls ] && echo 'с HLS Proxy' || echo 'без HLS Proxy (ссылки провайдера напрямую)')"
  if [ "$(c access)" = tunnel ]; then
    echo "Редактор:           только через SSH-туннель:"
    echo "                    ssh -N -L 8095:127.0.0.1:8095 root@$(c host)   ->   http://localhost:8095"
  else
    echo "Редактор:           $(c editor_url)   (логин: $(python3 -c 'import json;print(json.load(open("'"$(c auth_file)"'"))["user"])' 2>/dev/null || echo '?'))"
  fi
  local t; t=$(c main_token)
  [ -n "$t" ] && echo "Основной плейлист:  $(c public_base)$t.m3u8"
  echo "Программа (EPG):    $(c player_epg)"
  [ "$(c mode)" = hls ] && echo "Панель HLS Proxy:   $(c hls_url)"
  return 0
}

case "${1:-help}" in
  info|url) info ;;
  status)
    info; echo
    for u in $UNITS hls-proxy.service nginx.service; do
      [ "$u" = hls-proxy.service ] && [ "$(c mode)" != hls ] && continue
      printf '  %-22s %s\n' "$u" "$(systemctl is-active "$u" 2>/dev/null)"
    done
    echo; echo "Последняя сборка:"; systemctl show e4tv-build.service -p Result -p ExecMainExitTimestamp 2>/dev/null | sed 's/^/  /'
    python3 -c 'import json,sys; s=json.load(open(sys.argv[1])); print("  "+s.get("built_at","—")); [print("  "+l) for l in s.get("log",[])[-6:]]' "$(c data)/editor/state.json" 2>/dev/null || true ;;
  passwd)
    need_root "$@"
    [ "$(c access)" = tunnel ] && echo "Сейчас вход только через SSH-туннель — пароль сохранится на случай, если включите вход по паролю."
    old=$(python3 -c 'import json;print(json.load(open("'"$(c auth_file)"'"))["user"])' 2>/dev/null || echo admin)
    read -r -p "Логин [$old]: " u; u=${u:-$old}
    read -r -s -p "Новый пароль (Enter — придумать автоматически): " p; echo
    if [ -z "$p" ]; then p=$(python3 -c 'import secrets,string;a=string.ascii_letters+string.digits;print("".join(secrets.choice(a) for _ in range(14)))'); gen=1
    else read -r -s -p "Ещё раз: " p2; echo; [ "$p" = "$p2" ] || { echo "Пароли не совпали"; exit 1; }; gen=0; fi
    set_auth "$u" "$p" || exit 1
    echo "Готово. Все открытые сеансы редактора завершены."
    [ $gen = 1 ] && echo "Логин: $u   Пароль: $p" ;;
  _setauth) need_root "$@"; set_auth "$2" ;;
  streams)
    [ "$(c mode)" = hls ] || { echo "Лимит потоков есть только в режиме с HLS Proxy"; exit 1; }
    L="$(c hls_dir)/local.json"
    if [ -z "${2:-}" ]; then python3 -c 'import json,sys;v=json.load(open(sys.argv[1])).get("maxSimultaneousStreamCountPerClientDefault","?");print("Сейчас: без лимита" if isinstance(v,int) and v>=999 else f"Сейчас: не больше {v} каналов одновременно")' "$L"; exit 0; fi
    need_root "$@"
    set -- "$1" "$(case "${2,,}" in off|нет|без|unlimited) echo 0;; *) echo "$2";; esac)"
    [[ $2 =~ ^[0-9]+$ ]] && [ "$2" -ge 0 ] && [ "$2" -le 50 ] || { echo "Нужно число от 1 до 50, или 0 — без лимита"; exit 1; }
    python3 - "$L" "$2" <<'P'
import json, os, sys
p, n = sys.argv[1], int(sys.argv[2])
n = n or 999   # 0 = без лимита: в HLS Proxy пишем заведомо большое число
c = json.load(open(p, encoding="utf-8"))
c["maxSimultaneousStreamCountPerClientDefault"] = n
for k, cl in c.get("clients", {}).items():
    if isinstance(cl, dict) and not k.startswith("e4c_"): cl["maxStreamCount"] = n   # e4c_* — клиенты, у них свой лимит
st = os.stat(p); tmp = p + ".tmp"
with open(tmp, "w", encoding="utf-8") as f: json.dump(c, f, ensure_ascii=False, indent=1)
os.chown(tmp, st.st_uid, st.st_gid); os.chmod(tmp, 0o600); os.replace(tmp, p)
P
    python3 - "$(c data)/editor/rules.json" "$2" <<'P'
import json, os, sys
p, n = sys.argv[1], int(sys.argv[2])
try: r = json.load(open(p, encoding="utf-8"))
except Exception: sys.exit(0)
if not isinstance(r, dict): sys.exit(0)
r["stream_limit"] = n   # чтобы редактор показывал то же число и не вернул старое при следующей сборке (0 = без лимита)
r["stream_limit_mode"] = "manual"   # число задано вручную — «Авто» в редакторе выключается
st = os.stat(p); tmp = p + ".tmp"
with open(tmp, "w", encoding="utf-8") as f: json.dump(r, f, ensure_ascii=False, indent=1)
os.chown(tmp, st.st_uid, st.st_gid); os.chmod(tmp, 0o640); os.replace(tmp, p)
P
    systemctl restart hls-proxy && { [ "$2" = 0 ] && echo "Готово: без лимита каналов. HLS Proxy перезапущен." || echo "Готово: не больше $2 каналов одновременно. HLS Proxy перезапущен."; } ;;
  token)
    need_root "$@"
    old=$(c main_token)
    echo "Будет сделана новая ссылка основного плейлиста. Старая перестанет работать сразу:"
    echo "во всех телевизорах и плеерах нужно будет вставить новую."
    echo "(Ссылки плейлистов из редактора не меняются — для них есть кнопка «Новая ссылка».)"
    if [ "${2:-}" != -y ]; then read -r -p "Продолжить? [д/Н]: " a; case "${a,,}" in д|да|y|yes) ;; *) echo "Отменено"; exit 1;; esac; fi
    python3 - "$CONF" <<'P' || { echo "Не удалось записать $CONF"; exit 1; }
import json, os, secrets, string, sys
p = sys.argv[1]
c = json.load(open(p, encoding="utf-8"))
a = string.ascii_letters + string.digits
c["main_token"] = "".join(secrets.choice(a) for _ in range(24))
st = os.stat(p); tmp = p + ".tmp"
with open(tmp, "w", encoding="utf-8") as f: json.dump(c, f, ensure_ascii=False, indent=1)
os.chown(tmp, st.st_uid, st.st_gid); os.chmod(tmp, st.st_mode & 0o777); os.replace(tmp, p)
P
    systemctl restart e4tv-editor.service
    echo "Собираю плейлист по новой ссылке…"
    systemctl start e4tv-lists.service || echo "Сборка завершилась с ошибкой: e4tv logs"
    pl=$(c pl_dir); [ -n "$old" ] && rm -f "$pl/$old.m3u8"
    echo; echo "Готово. Новый основной плейлист:  $(c public_base)$(c main_token).m3u8" ;;
  update)
    need_root "$@"
    U=$(c update_url); U=${U:-https://raw.githubusercontent.com/koksik2022/evgen4ik-tv/main/get.sh}
    echo "Обновляю Evgen4ik TV с $U (настройки, плейлисты и ссылки сохранятся)…"
    T=$(mktemp /tmp/e4tv-get.XXXXXX)
    curl -fsSL --retry 2 --connect-timeout 20 -o "$T" "$U" || { rm -f "$T"; echo "Не удалось скачать $U"; exit 1; }
    exec bash "$T" --update --yes ;;   # exec: установщик перезапишет этот файл; get.sh сам сверяет SHA-256 установщика
  rebuild)
    need_root "$@"; date +%s > "$(c data)/editor/apply.trigger"; echo "Пересборка запущена. Ход: e4tv logs" ;;
  check)   # проверить потоки сейчас; итог — в редакторе («Источники» → «Автопроверка потоков»)
    need_root "$@"
    echo "Проверяю потоки (может занять несколько минут)…"; python3 "$APP/autocheck.py" ;;
  logs) journalctl -u e4tv-build -u e4tv-lists -u e4tv-editor -u e4tv-check -u e4tv-check-now -n "${2:-80}" --no-pager ;;
  uninstall)
    need_root "$@"
    echo "Будут удалены службы e4tv-*, программа $APP, сайт nginx evgen4ik-tv и команда e4tv."
    [ "${2:-}" = --purge ] && echo "А также ВСЕ данные: правила, плейлисты, настройки и HLS Proxy (если ставился этим установщиком)."
    read -r -p "Для подтверждения введите УДАЛИТЬ: " a; [ "$a" = "УДАЛИТЬ" ] || { echo "Отменено"; exit 1; }
    systemctl disable --now $UNITS e4tv-build.service e4tv-lists.service e4tv-check.service e4tv-check-now.service 2>/dev/null
    rm -f /etc/systemd/system/e4tv-*.service /etc/systemd/system/e4tv-*.path /etc/systemd/system/e4tv-*.timer
    rm -f /etc/nginx/sites-enabled/evgen4ik-tv /etc/nginx/sites-available/evgen4ik-tv /etc/letsencrypt/renewal-hooks/deploy/e4tv.sh /etc/nginx/e4tv-acl.conf
    systemctl reload nginx 2>/dev/null
    if [ "${2:-}" = --purge ]; then
      if [ -f /opt/hls-proxy/.installed-by-e4tv ]; then systemctl disable --now hls-proxy 2>/dev/null; rm -rf /opt/hls-proxy /etc/systemd/system/hls-proxy.service; fi
      rm -rf "$(c data)" "$(c pl_dir)" /etc/evgen4ik-tv
    fi
    systemctl daemon-reload; rm -rf "$APP"; rm -f /usr/local/bin/e4tv
    echo "Удалено." ;;
  *) cat <<'H'
e4tv info       — ссылки: редактор, основной плейлист, EPG
e4tv status     — состояние служб и последней сборки
e4tv passwd     — сменить логин/пароль редактора
e4tv token      — новая ссылка основного плейлиста (старая перестанет работать)
e4tv update     — обновить до последней версии с GitHub
e4tv rebuild    — пересобрать плейлист сейчас
e4tv check      — проверить потоки сейчас
e4tv streams N  — сколько каналов одновременно (лимит провайдера, режим с HLS Proxy); 0 — без лимита
e4tv logs [N]   — последние строки журнала
e4tv uninstall [--purge] — удалить (с --purge — вместе с данными)
H
  ;;
esac
